        <item name="android:textColorPrimary">@color/txt</item>
        <item name="android:textColorSecondary">@color/muted</item>
    </style>
    <style name="Teal" parent="Base">
        <item name="ctAccent">@color/teal_accent</item>
        <item name="ctInk">@color/teal_ink</item>
