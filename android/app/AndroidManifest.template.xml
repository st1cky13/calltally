<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.calltally.app"
    android:versionCode="31" android:versionName="1.0.1">
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Catch up encrypted: to be offered the messaging role, Call Tally must be able to receive texts and picture
         messages. It never sends: there is no SEND_SMS. An arriving text is passed through to the inbox unread. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <!-- Catch up encrypted needs to see and open the owner's own messaging app to switch back to it. The intent query
         matches any SMS-capable app (it answers smsto: SENDTO), so getLaunchIntentForPackage can find apps like Samsung
         Messages, not only Google Messages. The package entry stays for Google Messages' version lookup. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <package android:name="com.google.android.apps.messaging" />
    </queries>
    <application android:label="Call Tally" android:icon="@drawable/icon" android:allowBackup="false"
        android:debuggable="__DEBUGGABLE__"
        android:theme="@style/Teal">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".StartActivity" android:exported="false" />
        <activity android:name=".DayActivity" android:exported="false" />
        <activity android:name=".ContactsActivity" android:exported="false" />
        <activity android:name=".OptionsActivity" android:exported="false" android:label="Options" />
        <activity android:name=".PayActivity" android:exported="false" android:label="Pay periods" />
        <activity android:name=".WhoActivity" android:exported="false" android:label="Contacts" />
        <activity android:name=".CatchUpActivity" android:exported="false" android:label="Catch up encrypted" />
        <service android:name=".SyncJob" android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <!-- Catch up encrypted: the four components Android requires before it will offer Call Tally the messaging
             role. A text that arrives while it holds the role reaches the receiver below and is passed through to the
             inbox unread (SmsReceiver); the send paths do nothing but close, because Call Tally never sends. -->
        <receiver android:name=".SmsReceiver" android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver android:name=".MmsReceiver" android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <activity android:name=".SendActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <service android:name=".RespondService" android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <!--TEST_HOOK-->
    </application>
</manifest>
